# Chaves de API para os Modelos de Linguagem
# Copie este arquivo para .env e preencha com suas chaves reais:

# Google Gemini (Recomendado para custo-benefício e velocidade)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini (Opcional, default: google:gemini-3.8-flash)
GEMINI_MODEL=google:gemini-3.8-flash

# OpenAI (Opcional)
OPENAI_API_KEY=sua_chave_openai_aqui
